# MAUSAM client configuration.
# Leave VITE_API_BASE_URL EMPTY in development to use same-origin requests:
# the Vite dev server proxies /api to http://localhost:4000 automatically,
# and in production FastAPI serves the built client on the same origin.
# Set it only when the frontend and backend are hosted separately:
#   VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=